graph TD
    Start( )
    style Start stroke:#000,stroke-width:2px,fill:#000,color:#fff;
    End( )
    style End fill:#fff,stroke:#000,stroke-width:2px;
    fork1@{shape: fork}
    join1@{shape: join}

    %% Flow
    Start --> fork1

    %% Branch 1: Database Preparation
    fork1 --> A[Load DB Configuration]
    A -- "[DB Credentials]" --> B[Establish DB Connection]
    
    %% Branch 2: Data Processing
    fork1 --> C[Load Election Results Data]
    
    %% Aggregation check
    C -- "[Raw Results]" --> D{"Decision [Data at EAVS level?]"}
    D -- "[No]" --> E[Aggregate precinct data to EAVS level]
    E -- "[Aggregated Results]" --> F[Load EAVS Geounit Data]
    D -- "[Yes]" --> F
    
    %% Main processing steps
    F -- "[Geounit Data, Processed Results]" --> G[Create EAVS Lookup Map]
    G -- "[Lookup Map, Processed Results]" --> H[Map Results to EAVS Geounit Codes]
    H -- "[Mapped Data]" --> I[Calculate R/D Vote Split]
    I -- "[Split Data]" --> J[Format Data for Database]
    
    %% Join branches
    B -- "[DB Engine]" --> join1
    J -- "[Formatted Results]" --> join1

    %% Final Step
    join1 --> K[Write Election Results to Database]
    K --> End